# Postgres connection string. Supabase: Project ▸ Connect ▸ "Session pooler".
# Render: the database's "Internal Database URL".
DATABASE_URL=postgres://user:password@host:5432/dbname

# The name shown in the header, the sign-in screen and browser tabs.
NEXT_PUBLIC_APP_NAME=Vendor Atlas

# Optional. Set to "disable" if your Postgres has no TLS (TLS is used
# automatically for any host other than localhost).
# DATABASE_SSL=disable
