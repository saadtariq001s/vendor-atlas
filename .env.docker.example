# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Password for the database inside Docker. Anything long and random.
POSTGRES_PASSWORD=change-me-to-something-long

# The first administrator. Created on first start when the database is
# empty; ignored after that. Use at least 10 characters.
ADMIN_EMAIL=owner@company.ae
ADMIN_PASSWORD=change-me-too
ADMIN_NAME=Owner Name

# Shown in the header, the sign-in screen and browser tabs.
APP_NAME=Vendor Atlas

# Port on this PC. http://localhost:3000 by default.
APP_PORT=3000

# Only for `--profile tunnel`: the token of a Cloudflare tunnel.
# TUNNEL_TOKEN=

# Only for `--profile quick` (the free random address): who may open it.
# Each gets a one-time code by email first. Comma-separated, no spaces, or
# '*@company.ae'. Leave empty for no email step (the app's own sign-in remains).
# ALLOWED_EMAILS=owner@company.ae,you@yourmail.com

# Optional, with `--profile quick`: a permanent link that always forwards to
# the current address. LINK_REPO is a public GitHub repository with GitHub
# Pages turned on; LINK_TOKEN a fine-grained token with Contents read and
# write on that repository only. The link is https://<owner>.github.io/<repo>/
# LINK_REPO=owner/vendor-atlas-link
# LINK_TOKEN=
